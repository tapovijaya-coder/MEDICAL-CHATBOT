# MediBot AI - Environment Configuration

# Groq API Key (Required for LLM inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection
# Supported models:
# - qwen/qwen3.8-27b (recommended: highly articulate, structured medical responses)
# - openai/gpt-oss-120b
# - openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b

# Embeddings Model (Hugging Face)
# Default: sentence-transformers/all-MiniLM-L6-v2 (fast, lightweight, highly accurate 384-dim embeddings)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage Directories
DATA_DIR=data/uploaded_pdfs
VECTORSTORE_DIR=vectorstore

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=4

